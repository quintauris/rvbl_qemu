{
    "$schema": "../../../core/meta/peripheral.schema.json",
    "name": "uart_ns16550",
    "description": {
        "content-type": "text/markdown",
        "content": "Simple (write-only) Hardware-Software Interface model for https://en.wikipedia.org/wiki/16550_UART[NS16550] UART."
    },
    "addressables": {
        "registers": {
            "description": {
                "content": "Address space for control and data registers."
            },
            "size": "1K",
            "default": {
                "register": {
                    "class": "memory_mapped"
                }
            },
            "registers": {
                "data": {
                    "description": {
                        "content": "Receiver/Transmitter Holding register."
                    },
                    "offset": "0x0",
                    "width": 32,
                    "on_reset": {
                        "$RESET": {
                            "value": "0"
                        }
                    }
                },
                "line_status": {
                    "description": {
                        "content": "Line Status register."
                    },
                    "offset": "0x5",
                    "width": 8,
                    "fields": {
                        "data_ready": {
                            "description": {
                                "content": "Data Ready indicator."
                            },
                            "position": 0,
                            "length": 1,
                            "hw_volatile": true
                        },
                        "thr_empty": {
                            "description": {
                                "content": "THR (Transmitter Holding Register) Ready indicator."
                            },
                            "position": 5,
                            "length": 1,
                            "hw_volatile": true
                        }
                    }
                }
            }
        }
    }
}
