{
    "$schema": "../../../../core/meta/machine.schema.json",
    "name": "qemu_virt",
    "$comment": "Copyright 2026 Quintauris GmbH. Licensed under the Apache License, Version 2.0 (the \"License\", https://www.apache.org/licenses/LICENSE-2.0)",
    "word_size": 32,
    "imports": {
        "rvi20u32": {
            "file": "riscv/model/rvi20u32/model.json"
        },
        "aclint": {
            "file": "riscv/model/aclint/model.json",
            "substitutions": {
                "MTIMER_TIME_OFFSET": "0xBFF8",
                "MTIMER_COMPARE_OFFSET": "0x4000",
                "MSWI_MSIP_OFFSET": "0x0000",
                "SSWI_SETSSIP_OFFSET": "0x0000"
            }
        },
        "ns16550": {
            "file": "qemu/model/ns16550/model.json"
        }
    },
    "memory_map": {
        "rom0": {
            "base": "0x20000000",
            "size": "16K",
            "write": false,
            "execute": true,
            "default": {
                "register": {
                    "class": "memory_mapped"
                }
            }
        },
        "flash0": {
            "base": "0x20000000 + 16K",
            "size": "4M - 16K",
            "write": false,
            "default": {
                "register": {
                    "class": "memory_mapped"
                }
            }
        },
        "ram0": {
            "base": "0x80000000",
            "size": "12M",
            "execute": true,
            "default": {
                "register": {
                    "class": "memory_mapped"
                }
            }
        }
    },
    "peripherals": {
        "0": {
            "reference": "rvi20u32",
            "peripheral": {
                "base": "0"
            }
        },
        "aclint_default": {
            "reference": "aclint",
            "peripheral": {
                "base": "0x02000000"
            },
            "substitutions": {
                "HART_COUNT": "1"
            }
        },
        "uart_default": {
            "reference": "ns16550",
            "peripheral": {
                "base": "0x10000000",
                "substitutions": {
                    "RESET": "default"
                }
            }
        }
    },
    "resets": {
        "default": {
            "description": {
                "content-type": "text/plain",
                "content": "Default machine reset."
            }
        }
    },
    "parameters": {
        "mtime_frequency": {
            "stage": "compile",
            "class": "uint32",
            "value": "10m"
        },
        "hart_count": {
            "stage": "compile",
            "class": "uint32",
            "value": "1"
        },
        "cache_instructions_supported": {
            "stage": "compile",
            "class": "uint32",
            "value": "0"
        }
    }
}
