                "-cpu",
                "rv32i,b=on,f=on,m=on,u=on,zalrsc=on,zce=on,zcf=on,zcmop=on,zfa=on,zfbfmin=on,zfh=on,zicntr=on,zicond=on,zicsr=on,zifencei=on,zihintpause=on,zihpm=on,pmp=on,smepmp=off,smrnmi=off,smcdeleg=on,smcntrpmf=on,smdbltrp=on,sstc=on,priv_spec=v1.13.0",
