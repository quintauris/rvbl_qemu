{
    "$schema": "../../../../quintauris_community/meta/machine.schema.json",
    "name": "qemu_virt_multicore",
    "cpus": [
        {
            "include": "quintauris_community/model/rt_europa/model.json"
        }
    ],
    "memory_regions": [
        {
            "name": "rom0",
            "base": "0x20000000",
            "size": "16K",
            "write": false,
            "execute": true
        },
        {
            "name": "flash0",
            "base": "0x20000000 + 16K",
            "size": "4M - 16K",
            "write": false
        },
        {
            "name": "ram0",
            "base": "0x80000000",
            "size": "12M",
            "execute": true
        }
    ],
    "devices": [
        {
            "include": "riscv/model/aclint/model.json",
            "INSTANCE": "default",
            "BASE": "0x02000000",
            "MTIMER_TIME_OFFSET": "0xBFF8",
            "MTIMER_COMPARE_OFFSET": "0x4000",
            "MSWI_MSIP_OFFSET": "0x0000",
            "SSWI_SETSSIP_OFFSET": "0x0000",
            "HART_COUNT": "4"
        },
        {
            "include": "national_semiconductor/model/ns16550/model.json",
            "INSTANCE": "default",
            "BASE": "0x10000000"
        }
    ],
    "parameters": [
        {
            "name": "mtime_frequency",
            "stage": "compile",
            "class": "uint32",
            "value": "10m"
        },
        {
            "name": "hart_count",
            "stage": "compile",
            "class": "uint32",
            "value": "4"
        },
        {
            "name": "cache_instructions_supported",
            "stage": "compile",
            "class": "uint32",
            "value": "1"
        }
    ]
}
