{
    "runners": {
        "^qemu.system32-": {
            "default": [
                "-machine",
                "virt",
                "-smp",
                "4",
                "-m",
                "16M",
                "-semihosting-config",
                "enable=on",
                "-nographic",
                "-serial",
                "mon:stdio"
            ]
        }
    },
    "default_toolchain_target": "riscv32_ilp32"
}
