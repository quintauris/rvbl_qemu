{
    "programs": [
        "qemu-system-riscv32-$machine",
        "qemu-system-riscv32"
    ],
    "parameters": {
        "default": [
            "-bios",
            "$file"
        ],
        "debug": [
            "-bios",
            "$file",
            "-s",
            "-S"
        ]
    },
    "docker": {
        "container": "qemu-system-riscv32"
    }
}
